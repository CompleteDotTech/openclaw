+async function main() {
+  const beforePath = JSON.parse(process.env.PROOF_CHECKOUTS ?? '{}').before;
+  const head = process.env.SHA;
+  if (process.argv.length !== 3 || !key || !/^[a-f0-9]{40}$/.test(head ?? '') ||
+      !beforePath || !process.env.PROOF_RESULTS_DIR || head === BEFORE) {
+    throw new Error('Expected the scripted-proof workflow with a pinned SHA, built before checkout, and results directory');
+  }
+  const results = resolve(process.env.PROOF_RESULTS_DIR);
+  await mkdir(results, { recursive: true });
+  const visual = await mkdtemp(join(results, 'visual-'));
+  const after = await runBuild(resolve(process.argv[2]), head, false, results, visual);
+  const before = await runBuild(resolve(beforePath), BEFORE, true, results, visual);
+  const pairedTake = (cases) => cases.find((c) => c.id === PAIR_CASE)?.takes.find((t) => t.take === PAIR_TAKE);
+  const a = pairedTake(after), b = pairedTake(before);
+  const passed = a?.status === 'PASS' && a.frame === 'after.png' && b?.status === 'PASS' && b.frame === 'before.png';
+  await writeFile(join(visual, 'assertions.json'), JSON.stringify({
+    proof: 'Chromium fake-media capture with a prerecorded WAV', case: PAIR_CASE, take: PAIR_TAKE,
+    viewport: [1440, 900], colorScheme: 'dark', before: { head: BEFORE, ...b }, after: { head, ...a }, passed,
+  }, null, 2) + '\n');
+  process.exitCode = [...after, ...before].some((c) => c.status === 'FAIL' || c.status === 'ERROR') ? 1 :
+    !passed || [...after, ...before].some((c) => c.status === 'INCONCLUSIVE_STT') ? 2 : 0;
+}

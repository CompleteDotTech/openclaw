+async function saveFrame(page, target, dir, which, label) {
+  const box = await target.boundingBox();
+  check(box && box.width > 0 && box.height > 0, 'Annotation target is not visible');
+  const png = await page.screenshot({ path: join(dir, which + '.png'), animations: 'disabled', scale: 'css' });
+  const marked = await page.evaluate(async ({ image, box, label }) => {
+    const bytes = Uint8Array.from(atob(image), (ch) => ch.charCodeAt(0));
+    const img = await createImageBitmap(new Blob([bytes], { type: 'image/png' }));
+    const canvas = document.createElement('canvas');
+    canvas.width = img.width;
+    canvas.height = img.height;
+    const ctx = canvas.getContext('2d');
+    ctx.drawImage(img, 0, 0);
+    img.close();
+    ctx.strokeStyle = '#ffd36b';
+    ctx.lineWidth = 3;
+    ctx.strokeRect(box.x - 2, box.y - 2, box.width + 4, box.height + 4);
+    ctx.font = 'bold 16px sans-serif';
+    const x = Math.max(2, box.x), y = Math.max(2, box.y - 30);
+    ctx.fillStyle = '#19130a';
+    ctx.fillRect(x, y, ctx.measureText(label).width + 16, 25);
+    ctx.fillStyle = '#ffd36b';
+    ctx.fillText(label, x + 8, y + 18);
+    return canvas.toDataURL().split(',')[1];
+  }, { image: png.toString('base64'), box, label });
+  await writeFile(join(dir, which + '-annotated.png'), Buffer.from(marked, 'base64'));
